    "creation.intentBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe your collection and what matters to you. Arca prepares the instructions for your AI assistant."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صف مجموعتك والتفاصيل التي تهمك. يُعد أركا التعليمات لمساعدك الذكي."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koleksiyonunuzu ve sizin için önemli olan ayrıntıları anlatın. Arca, yapay zekâ asistanınız için yönergeleri hazırlar."
          }
        }
      }
    },
    "creation.intentExample": {
      "extractionState": "manual",
      "localizations": {
        "en": {
