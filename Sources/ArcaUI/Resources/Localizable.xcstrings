    "delete.recordBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes the record from this device. For a synced Space, the deletion will sync to your other devices. This cannot be undone in Arca."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُزال السجل من هذا الجهاز. إذا كانت المساحة متزامنة، فستتم مزامنة الحذف مع أجهزتك الأخرى. لا يمكن التراجع عن ذلك في أركا."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt bu cihazdan kaldırılır. Alan eşitleniyorsa silme işlemi diğer cihazlarınıza da eşitlenir. Bu işlem Arca içinde geri alınamaz."
          }
        }
      }
    },
    "delete.recordTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete “%@”?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف «%@»؟"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” silinsin mi?"
          }
        }
      }
    },
    "delete.spaceBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes this Space's local records and attachments. Local-Only data cannot be recovered without a backup. Cloud copies remain and can sync back."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى إزالة السجلات والمرفقات المحلية لهذه المساحة. لا يمكن استعادة البيانات المحلية فقط دون نسخة احتياطية. ستبقى النسخ السحابية وقد تتم مزامنتها مجدداً."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu alanın yerel kayıtları ve ekleri kaldırılır. Yalnızca cihazda tutulan veriler yedek olmadan kurtarılamaz. Bulut kopyaları kalır ve yeniden eşitlenebilir."
          }
        }
      }
    },
    "delete.spaceTitle": {
      "extractionState": "manual",
