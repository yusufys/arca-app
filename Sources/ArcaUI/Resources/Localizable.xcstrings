          "stringUnit": {
            "state": "translated",
            "value": "Records live on your device and synchronize with end-to-end encryption across up to 2 devices for free."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى السجلات على جهازك وتتم مزامنتها بتشفير تام بين الطرفين على جهازين مجاناً."
          }
