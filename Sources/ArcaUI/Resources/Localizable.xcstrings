          "stringUnit": {
            "state": "translated",
            "value": "Delete “%@”?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف «%@»؟"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” silinsin mi?"
          }
        }
      }
    },
