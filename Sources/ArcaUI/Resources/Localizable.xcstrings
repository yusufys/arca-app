    "The sync service handles your account details, enrolled devices and their public keys, record identifiers, encrypted sizes and sync activity.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sync service handles your account details, enrolled devices and their public keys, record identifiers, encrypted sizes and sync activity."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşzamanlama hizmeti hesap bilgilerinizi, kayıtlı cihazları ve açık anahtarlarını, kayıt kimliklerini, şifreli veri boyutlarını ve eşzamanlama etkinliğini işler."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعالج خدمة المزامنة تفاصيل حسابك وأجهزتك المسجّلة ومفاتيحها العامة ومعرّفات السجلات وأحجام البيانات المشفّرة ونشاط المزامنة."
          }
        }
      }
    },
    "These demo collections contain fictional records so you can try Arca.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These demo collections contain fictional records so you can try Arca."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arca’yı deneyebilmeniz için bu örnek koleksiyonlar kurgusal kayıtlar içerir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتوي مجموعات العرض هذه على سجلات خيالية لتجربة Arca."
          }
        }
      }
    },
    "This cannot be undone. Your local records will be kept, and all Spaces will become Local-Only.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This cannot be undone. Your local records will be kept, and all Spaces will become Local-Only."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem geri alınamaz. Yerel kayıtlarınız korunur ve tüm alanlar yalnızca cihazda saklanır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن التراجع عن هذا الإجراء. ستبقى سجلاتك المحلية، وستصبح جميع المساحات محلية فقط."
          }
        }
      }
    },
    "This password is verified on this device. It is separate from your account password and recovery phrase.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
