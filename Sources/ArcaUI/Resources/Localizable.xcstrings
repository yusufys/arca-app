        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önerilen bir koleksiyon seçin veya oluşturmak istediğiniz koleksiyonu anlatın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مجموعة مقترحة أو صف المجموعة التي تريد إنشاءها."
          }
        }
      }
    },
    "Choose the collections to copy into your Space, or start with an empty Space.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the collections to copy into your Space, or start with an empty Space."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alanınıza kopyalanacak koleksiyonları seçin veya boş bir alanla başlayın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر المجموعات التي تريد نسخها إلى مساحتك، أو ابدأ بمساحة فارغة."
          }
        }
      }
    },
    "Choose whether a Space syncs. In a synced Space, you can keep a sensitive field or collection on this device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose whether a Space syncs. In a synced Space, you can keep a sensitive field or collection on this device."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir alanın eşitlenip eşitlenmeyeceğini seçin. Eşitlenen alanlarda hassas alanları veya koleksiyonları yalnızca bu cihazda tutabilirsiniz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر ما إذا كنت تريد مزامنة المساحة. ويمكنك إبقاء حقل أو مجموعة حساسة على هذا الجهاز فقط حتى داخل مساحة متزامنة."
          }
        }
      }
    },
