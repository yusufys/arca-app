    "Arca Sync is the default cloud-synced E2EE mode for new Spaces. Local-Only is always available whenever you want records never to leave this phone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arca Sync is the default cloud-synced E2EE mode for new Spaces. Local-Only is always available whenever you want records never to leave this phone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni alanlar için varsayılan seçenek, uçtan uca şifreli Arca Sync’tir. Kayıtlarınızın telefonunuzda kalmasını isterseniz yalnızca bu cihazda saklamayı seçebilirsiniz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مزامنة أركا هي الخيار الافتراضي للمساحات الجديدة، مع تشفير تام بين الطرفين. ويمكنك دائماً اختيار التخزين على الجهاز فقط لإبقاء سجلاتك على هاتفك."
          }
        }
      }
    },
    "Arca is Locked": {
      "extractionState": "manual",
