    "Remote deletion pending. Uploads for this collection remain paused until confirmed. Offline devices may retain earlier copies.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote deletion pending. Uploads for this collection remain paused until confirmed. Offline devices may retain earlier copies."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحذف عن بُعد قيد الانتظار. يتوقف رفع هذه المجموعة حتى تأكيد الحذف. قد تحتفظ الأجهزة غير المتصلة بنسخ سابقة."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzaktan silme bekleniyor. Onaylanana kadar bu koleksiyonun yüklemeleri duraklatılır. Çevrimdışı cihazlarda eski kopyalar kalabilir."
          }
        }
      }
    },
    "Target Storage Mode": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Target Storage Mode"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طريقة التخزين المستهدفة"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedef depolama modu"
          }
        }
      }
    },
    "Arca Sync is the default cloud-synced E2EE mode across devices.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arca Sync is the default cloud-synced E2EE mode across devices."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مزامنة آركا هي الطريقة الافتراضية للمزامنة بين الأجهزة بتشفير تام بين الطرفين."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arca Sync, cihazlar arasında uçtan uca şifreli eşzamanlama için varsayılan moddur."
          }
        }
      }
    },
    "Local-Only keeps all records and attachments strictly on this device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local-Only keeps all records and attachments strictly on this device."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظ الوضع المحلي فقط جميع السجلات والمرفقات على هذا الجهاز حصريًا."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca yerel modu, tüm kayıtları ve ekleri sadece bu cihazda tutar."
          }
        }
      }
    },
    "Personal Cloud Backup sends direct encrypted archives to iCloud or Google Drive.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Personal Cloud Backup sends direct encrypted archives to iCloud or Google Drive."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسل النسخ الاحتياطي السحابي الشخصي أرشيفات مشفرة مباشرة إلى iCloud أو Google Drive."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişisel bulut yedeklemesi, şifreli arşivleri doğrudan iCloud veya Google Drive’a gönderir."
          }
        }
      }
    },
    "Request & Verify Deletion of Remote Encrypted Copies": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request & Verify Deletion of Remote Encrypted Copies"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طلب حذف النسخ المشفرة البعيدة والتحقق منه"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzaktaki şifreli kopyaların silinmesini iste ve doğrula"
          }
        }
      }
    },
    "I consent to uploading end-to-end encrypted records for this Space": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I consent to uploading end-to-end encrypted records for this Space"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوافق على رفع سجلات هذه المساحة بتشفير تام بين الطرفين"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu alanın uçtan uca şifrelenmiş kayıtlarının yüklenmesini kabul ediyorum"
          }
        }
      }
    },
    "Record values, collection schemas and field labels are encrypted on this device before syncing. Forge receives encrypted changes and wrapped recovery keys. File attachments imported into Local-Only Spaces stay on this device unless you export them.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record values, collection schemas and field labels are encrypted on this device before syncing. Forge receives encrypted changes and wrapped recovery keys. File attachments imported into Local-Only Spaces stay on this device unless you export them."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُشفّر قيم السجلات وبنية المجموعات وتسميات الحقول على هذا الجهاز قبل المزامنة. يستقبل الخادم تغييرات مشفرة ومفاتيح استرداد محمية. تبقى مرفقات المساحات المحلية على هذا الجهاز ما لم تصدّرها."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt değerleri, koleksiyon şemaları ve alan etiketleri eşzamanlanmadan önce bu cihazda şifrelenir. Sunucu şifreli değişiklikleri ve korumalı kurtarma anahtarlarını alır. Yalnızca yerel alanlara eklenen dosyalar, dışa aktarmadığınız sürece bu cihazda kalır."
          }
        }
      }
    },
    "• Account identifier and subscription entitlement tier\n• Enrolled device count and device labels\n• Encrypted blob byte sizes and opaque UUIDs\n• Request timestamps and sync cursors": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "• Account identifier and subscription entitlement tier\n• Enrolled device count and device labels\n• Encrypted blob byte sizes and opaque UUIDs\n• Request timestamps and sync cursors"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "• معرّف الحساب ومستوى الاشتراك\n• عدد الأجهزة المسجلة وتسمياتها\n• أحجام البيانات المشفرة ومعرّفاتها\n• أوقات الطلبات ومؤشرات المزامنة"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "• Hesap kimliği ve abonelik düzeyi\n• Kayıtlı cihaz sayısı ve cihaz etiketleri\n• Şifreli verilerin boyutları ve UUID kimlikleri\n• İstek zamanları ve eşzamanlama imleçleri"
          }
        }
      }
    },
    "Working Offline • Local Storage Active": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Working Offline • Local Storage Active"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعمل دون اتصال • التخزين المحلي نشط"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrimdışı çalışılıyor • Yerel depolama etkin"
          }
        }
      }
    },
    "You can read, create, and edit records without internet access.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can read, create, and edit records without internet access."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك قراءة السجلات وإنشاؤها وتعديلها دون اتصال بالإنترنت."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
