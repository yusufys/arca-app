          }
        }
      }
    },
    "All records and attachments remain on this device. Reading, searching and editing continue to work locally.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All records and attachments remain on this device. Reading, searching and editing continue to work locally."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى جميع السجلات والمرفقات على هذا الجهاز. تستمر القراءة والبحث والتعديل محليًا."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm kayıtlar ve ekler bu cihazda kalır. Okuma, arama ve düzenleme yerel olarak çalışmaya devam eder."
          }
        }
      }
    },
    "Future uploads stop. Existing remote copies remain unless you request and verify their deletion. Offline devices may retain earlier copies.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Future uploads stop. Existing remote copies remain unless you request and verify their deletion. Offline devices may retain earlier copies."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتوقف عمليات الرفع اللاحقة. تبقى النسخ البعيدة ما لم تطلب حذفها وتتحقق منه. قد تحتفظ الأجهزة غير المتصلة بنسخ سابقة."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni yüklemeler durur. Silinmelerini isteyip doğrulamadığınız sürece uzak kopyalar kalır. Çevrimdışı cihazlarda eski kopyalar bulunabilir."
          }
        }
      }
    },
    "Existing remote copies have been deleted. Previously downloaded data may remain on offline devices.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Existing remote copies have been deleted. Previously downloaded data may remain on offline devices."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم حذف النسخ البعيدة. قد تبقى البيانات التي نُزّلت سابقًا على أجهزة غير متصلة."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzaktaki kopyalar silindi. Daha önce indirilen veriler çevrimdışı cihazlarda kalabilir."
          }
        }
      }
    },
    "Records are encrypted on this device before they are uploaded for sync.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records are encrypted on this device before they are uploaded for sync."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُشفّر السجلات على هذا الجهاز قبل رفعها للمزامنة."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlar eşzamanlama için yüklenmeden önce bu cihazda şifrelenir."
          }
        }
      }
    },
    "Existing remote copies are unchanged until you apply a storage change or request deletion.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Existing remote copies are unchanged until you apply a storage change or request deletion."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى النسخ البعيدة دون تغيير حتى تطبق تغيير التخزين أو تطلب حذفها."
          }
        },
