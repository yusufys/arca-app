    "Delete your cloud account, encrypted remote records, recovery material and device registrations. Local records stay on this device in Local-Only Spaces. Any App Store subscription must be managed separately.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete your cloud account, encrypted remote records, recovery material and device registrations. Local records stay on this device in Local-Only Spaces. Any App Store subscription must be managed separately."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احذف حسابك السحابي وسجلاتك المشفرة البعيدة وبيانات الاسترداد وتسجيلات الأجهزة. تبقى السجلات المحلية على هذا الجهاز في مساحات محلية فقط. يجب إدارة اشتراك App Store بشكل منفصل."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulut hesabınızı, şifreli uzak kayıtları, kurtarma verilerini ve cihaz kayıtlarını silin. Yerel kayıtlar bu cihazdaki yalnızca yerel alanlarda kalır. App Store aboneliğinizi ayrıca yönetmelisiniz."
          }
        }
      }
    },
