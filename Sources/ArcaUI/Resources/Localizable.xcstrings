          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel QR kodu, bu alana sahip cihazlarda kaydı yalnızca kimliğiyle bulur. Kayıt içeriğini içermez veya iletmez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحدّد رمز QR المحلي هذا السجل بمعرّفه فقط على الأجهزة التي تملك المساحة. ولا يتضمّن محتوى السجل أو يرسله."
          }
