        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihazınız değişiklikleri yüklemeden önce şifreler. Eşitleme hizmeti, şifrelenmiş değişiklikleri ve korunan kurtarma anahtarlarını saklar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشفّر جهازك التغييرات قبل رفعها. وتخزّن خدمة المزامنة التغييرات المشفّرة ومفاتيح الاسترداد المحمية."
          }
        }
      }
    },
