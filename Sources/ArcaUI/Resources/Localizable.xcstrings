    "Your account password signs you in, while your Recovery Key decrypts your records if you ever lose all enrolled devices.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account password signs you in, while your Recovery Key decrypts your records if you ever lose all enrolled devices."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap parolanızla giriş yaparsınız. Kayıtlı cihazlarınızın tümünü kaybederseniz kayıtlarınızın şifresini kurtarma anahtarınız çözer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم كلمة مرور حسابك لتسجيل الدخول. وإذا فقدت جميع أجهزتك المسجّلة، يفك مفتاح الاسترداد تشفير سجلاتك."
          }
        }
      }
    },
    "Your device encrypts record changes before upload. The sync service stores encrypted changes and protected recovery keys.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your device encrypts record changes before upload. The sync service stores encrypted changes and protected recovery keys."
          }
