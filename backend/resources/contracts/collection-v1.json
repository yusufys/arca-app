{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Arca collection schema v1",
  "x-arca-version": 1,
  "x-arca-max-document-bytes": 262144,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "fields"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "\\S"
    },
    "iconName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "\\S"
    },
    "colorHex": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "type"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "\\S"
          },
          "type": {
            "type": "string",
            "enum": [
              "short_text",
              "long_text",
              "number",
              "currency",
              "date",
              "date_time",
              "boolean",
              "single_select",
              "multi_select",
              "rating",
              "attachment"
            ]
          },
          "isRequired": {
            "type": "boolean"
          },
          "isPrimaryTitle": {
            "type": "boolean"
          },
          "options": {
            "type": "array",
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "\\S"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "single_select",
                    "multi_select"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "options"
              ],
              "properties": {
                "options": {
                  "minItems": 1
                }
              }
            },
            "else": {
              "properties": {
                "options": {
                  "maxItems": 0
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "isPrimaryTitle"
              ],
              "properties": {
                "isPrimaryTitle": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "type": {
                  "const": "short_text"
                }
              }
            }
          }
        ]
      },
      "contains": {
        "type": "object",
        "required": [
          "isPrimaryTitle"
        ],
        "properties": {
          "isPrimaryTitle": {
            "const": true
          }
        }
      },
      "minContains": 0,
      "maxContains": 1
    }
  }
}
